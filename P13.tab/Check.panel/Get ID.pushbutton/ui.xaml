<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get Selected Element IDs" Height="380" Width="480" WindowStartupLocation="CenterScreen" Background="#F4F5F7" FontFamily="Segoe UI" FontSize="12" Topmost="True">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1B365D" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Get Selected Element IDs" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="lbl_status" Text="IDs copied to clipboard!" Foreground="#A2C4C9" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="P13 Tool" Foreground="#E0E0E0" FontSize="11" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Content: Table & Textbox -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Table of Selected Elements -->
            <DataGrid x:Name="grid_selected" Grid.Row="0" AutoGenerateColumns="False" 
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" RowHeight="24"
                      Background="White" BorderBrush="#E5E5EA" BorderThickness="1" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Element ID" Binding="{Binding Id}" Width="100" IsReadOnly="True" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Copy raw textbox header -->
            <TextBlock Grid.Row="1" Text="Raw IDs (Comma-separated):" FontWeight="SemiBold" Margin="0,6,0,4" Foreground="#333333"/>

            <!-- Raw IDs textbox -->
            <TextBox x:Name="txt_raw_ids" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto" Background="#FBFBFB" BorderBrush="#CCCCCC" BorderThickness="1" 
                     FontFamily="Consolas" FontSize="11" Padding="4"/>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btn_pick" Grid.Column="0" Content="📥 Pick on Screen" Height="32" Width="135" Margin="0,0,8,0"
                    Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1" FontWeight="Bold" Foreground="#1B5E20" Cursor="Hand"
                    ToolTip="Temporarily hide this window and pick elements directly on screen in Revit."/>
            <Button x:Name="btn_copy_tsv" Grid.Column="1" Content="📋 Copy Full Info" Height="32" Margin="0,0,8,0"
                    Background="#F5F5F5" BorderBrush="#DCDCDC" BorderThickness="1" FontWeight="SemiBold" Foreground="#333333" Cursor="Hand"/>
            <Button x:Name="btn_copy_ids" Grid.Column="2" Content="📋 Copy Raw IDs" Height="32" Width="120"
                    Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" FontWeight="Bold" Foreground="#0D47A1" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
