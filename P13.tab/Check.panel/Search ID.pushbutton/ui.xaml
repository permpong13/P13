<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ค้นหาวัตถุด้วย Element ID" Height="620" Width="850" WindowStartupLocation="CenterScreen" Background="#F4F5F7" FontFamily="Segoe UI" FontSize="12" Topmost="True">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Content Area -->
            <RowDefinition Height="*"/>
            <!-- Action Buttons Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1B365D" CornerRadius="4" Padding="15,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ค้นหาวัตถุด้วย Element ID" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="ค้นหา ตรวจสอบ ซ่อน/แสดง และไฮไลท์วัตถุใน Revit ด้วยรหัส Element ID หรือ Unique ID" Foreground="#E0E0E0" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="P13 Tool" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Input & Search -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="1. ใส่รหัส Element ID หรือ Unique ID" FontWeight="Bold" FontSize="12" Foreground="#333333"/>
                        <TextBlock Text="คั่นด้วยเครื่องหมายจุลภาค (,), เว้นวรรค หรือขึ้นบรรทัดใหม่" FontSize="10" Foreground="Gray" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBox x:Name="txt_ids" Grid.Row="1" 
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                             TextWrapping="Wrap" BorderBrush="#CCCCCC" BorderThickness="1" 
                             FontFamily="Consolas" FontSize="12" Padding="5"/>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button x:Name="btn_search" Content="🔍 เริ่มค้นหาและตรวจสอบ" 
                                Height="32" FontWeight="Bold" 
                                Background="#1B365D" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right Panel: Results Grid -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ผลการค้นหา" FontWeight="Bold" FontSize="12" Foreground="#333333"/>
                            <TextBlock x:Name="lbl_stats" Text=" (ไม่มีรายการ)" FontSize="11" Foreground="Gray" Margin="5,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btn_check_all" Content="☑ เลือกทั้งหมด" Width="95" Height="22" Margin="0,0,4,0" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="1"/>
                            <Button x:Name="btn_uncheck_all" Content="☐ ล้างการเลือก" Width="95" Height="22" Margin="0,0,4,0" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="1"/>
                            <Button x:Name="btn_invert" Content="⮂ สลับการเลือก" Width="95" Height="22" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="1"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="grid_results" Grid.Row="1" AutoGenerateColumns="False" 
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" RowHeight="26"
                              Background="White" BorderBrush="#E5E5EA" BorderThickness="1"
                              VirtualizingStackPanel.IsVirtualizing="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <!-- Selection Checkbox -->
                            <DataGridTemplateColumn Width="35">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Element ID -->
                            <DataGridTextColumn Header="รหัสวัตถุ (ID)" Binding="{Binding Id}" Width="85" IsReadOnly="True" FontWeight="SemiBold"/>
                            
                            <!-- Category -->
                            <DataGridTextColumn Header="หมวดหมู่ (Category)" Binding="{Binding Category}" Width="120" IsReadOnly="True"/>
                            
                            <!-- Family Name -->
                            <DataGridTextColumn Header="ชื่อแฟมิลี่ (Family)" Binding="{Binding FamilyName}" Width="135" IsReadOnly="True"/>

                            <!-- Type Name -->
                            <DataGridTextColumn Header="ชื่อประเภท (Type)" Binding="{Binding TypeName}" Width="135" IsReadOnly="True"/>

                            <!-- Level -->
                            <DataGridTextColumn Header="ระดับชั้น (Level)" Binding="{Binding Level}" Width="90" IsReadOnly="True"/>

                            <!-- Workset -->
                            <DataGridTextColumn Header="เวิร์กเซต (Workset)" Binding="{Binding Workset}" Width="90" IsReadOnly="True"/>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="สถานะการตรวจสอบ (Status)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" 
                                                   Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btn_copy" Content="📋 คัดลอกตาราง" Width="110" Height="36" Margin="0,0,8,0" 
                        Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" FontWeight="SemiBold" Foreground="#333333" Cursor="Hand"/>
                <Button x:Name="btn_clear" Content="🗑️ ล้างค่าหน้าจอ" Width="110" Height="36" 
                        Background="#FFEBEE" BorderBrush="#FFCDD2" BorderThickness="1" FontWeight="SemiBold" Foreground="#B71C1C" Cursor="Hand"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btn_reset_view" Content="🔄 รีเซ็ตมุมมอง" Width="110" Height="36" Margin="0,0,8,0"
                        Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="1" FontWeight="SemiBold" Foreground="#37474F" Cursor="Hand"
                        ToolTip="ล้างการซ่อนวัตถุชั่วคราวและสีไฮไลท์ทั้งหมดในมุมมองปัจจุบัน"/>
                <Button x:Name="btn_highlight" Content="🎨 ไฮไลท์สี" Width="110" Height="36" Margin="0,0,8,0"
                        Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1" FontWeight="Bold" Foreground="#1B5E20" Cursor="Hand"
                        ToolTip="ลงสีเขียวทึบให้กับวัตถุที่เลือกในตารางชั่วคราว"/>
                <Button x:Name="btn_isolate" Content="👁️ แยกแสดงวัตถุ" Width="110" Height="36" Margin="0,0,8,0"
                        Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" FontWeight="Bold" Foreground="#E65100" Cursor="Hand"
                        ToolTip="ซ่อนวัตถุอื่นชั่วคราวและแสดงเฉพาะวัตถุที่เลือกในตาราง"/>
                <Button x:Name="btn_select" Content="📌 เลือกวัตถุและซูม" Width="145" Height="36" 
                        Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="2" FontWeight="Bold" Foreground="#0D47A1" Cursor="Hand"
                        ToolTip="คลิกเลือกวัตถุใน Revit และปรับซูมให้อยู่กึ่งกลางหน้าจอ"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
