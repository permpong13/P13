<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chain Dimension"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#101827"
        Foreground="#E5E7EB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#172033"/>
        <SolidColorBrush x:Key="PanelSoftBrush" Color="#1E2A42"/>
        <SolidColorBrush x:Key="BorderBrushP13" Color="#30415F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="P13Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushP13}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#06121A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#243149"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="TextLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12" Background="#0F766E">
                    <Grid>
                        <Path Stroke="#CCFBF1" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 10 16 L 38 16 M 12 10 L 12 22 M 24 10 L 24 22 M 36 10 L 36 22"/>
                        <Path Stroke="#38BDF8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 11 33 L 37 33 M 11 29 L 11 39 M 24 29 L 24 39 M 37 29 L 37 39"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="Chain Dimension" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Create chained dimensions while preserving actual element spacing by default."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource P13Card}">
                <StackPanel>
                    <TextBlock Text="Selection Mode" FontSize="14" FontWeight="SemiBold"/>
                    <RadioButton x:Name="selectionWindow"
                                 Content="Window select elements"
                                 GroupName="SelectionMode"
                                 IsChecked="True"
                                 Click="selection_changed"/>
                    <RadioButton x:Name="selectionManual"
                                 Content="Pick dimension references manually"
                                 GroupName="SelectionMode"
                                 Click="selection_changed"/>

                    <StackPanel x:Name="categoriesPanel" Margin="0,12,0,0">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Categories to Measure" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Select All" Click="select_all_categories" Style="{StaticResource TextLinkButton}"/>
                                <TextBlock Text=" | " Foreground="{StaticResource MutedBrush}" Margin="4,0" FontSize="11" VerticalAlignment="Center"/>
                                <Button Content="Clear All" Click="clear_all_categories" Style="{StaticResource TextLinkButton}"/>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="CategoriesList" Height="100" SelectionMode="Multiple"
                                 Background="#172033" Foreground="#E5E7EB" BorderBrush="#30415F" BorderThickness="1"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="Margin" Value="1"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource P13Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Dimension Direction" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton x:Name="directionHorizontal" Content="Horizontal" GroupName="Direction" IsChecked="True"/>
                        <RadioButton x:Name="directionVertical" Content="Vertical" GroupName="Direction"/>
                        <RadioButton x:Name="directionAligned" Content="Aligned by selected items" GroupName="Direction"/>
                    </StackPanel>
                </Border>

                <Border x:Name="targetPanel" Grid.Column="2" Style="{StaticResource P13Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Family Reference Side" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton x:Name="targetStart" Content="Start side of each family" GroupName="TargetSide" IsChecked="True"/>
                        <RadioButton x:Name="targetEnd" Content="End side of each family" GroupName="TargetSide"/>
                        <RadioButton x:Name="targetBoth" Content="Both sides of each family" GroupName="TargetSide"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <Border Style="{StaticResource P13Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Spacing Behavior" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton x:Name="spacingActual"
                                     Content="Preserve actual spacing (supports unequal gaps)"
                                     GroupName="SpacingBehavior"
                                     IsChecked="True"/>
                        <TextBlock Text="Sets Equality Display to Equality Formula without equalizing or repositioning elements."
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="22,3,0,0"
                                   TextWrapping="Wrap"/>
                        <RadioButton x:Name="spacingEqual"
                                     Content="Make all segments equal (EQ constraint)"
                                     GroupName="SpacingBehavior"
                                     Margin="0,12,0,0"/>
                        <TextBlock Text="May move unlocked elements. A confirmation will be shown before continuing."
                                   Foreground="#FBBF24"
                                   Margin="22,3,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                         Content="Cancel"
                         Style="{StaticResource SecondaryButton}"
                         Click="cancel_clicked"/>
                <Button Grid.Column="3"
                         Content="Start"
                         Style="{StaticResource PrimaryButton}"
                         Click="start_clicked"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
