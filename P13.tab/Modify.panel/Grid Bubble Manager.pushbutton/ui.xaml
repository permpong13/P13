<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grid Bubble Manager"
        Width="680"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#101827"
        Foreground="#E5E7EB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#172033"/>
        <SolidColorBrush x:Key="BorderBrushP13" Color="#30415F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="P13Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushP13}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#06121A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonShell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#243149"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Border Padding="20">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="50" Height="50" CornerRadius="12" Background="#0F766E">
                    <Grid>
                        <Line X1="12" Y1="10" X2="12" Y2="40" Stroke="#CCFBF1" StrokeThickness="2"/>
                        <Line X1="38" Y1="10" X2="38" Y2="40" Stroke="#CCFBF1" StrokeThickness="2"/>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="6,4,0,0" Fill="#38BDF8"/>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,6,4" Fill="#2DD4BF"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="Grid Bubble Manager" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Standardize grid bubbles by view direction, crop boundary, or current state."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource P13Card}">
                    <StackPanel>
                        <TextBlock Text="Selection Mode" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton x:Name="selectionCurrent"
                                     Content="Use current selection"
                                     GroupName="SelectionMode"/>
                        <RadioButton x:Name="selectionWindow"
                                     Content="Window select grids"
                                     GroupName="SelectionMode"
                                     IsChecked="True"/>
                        <RadioButton x:Name="selectionAllVisible"
                                     Content="All visible grids in active view"
                                     GroupName="SelectionMode"/>
                        <RadioButton x:Name="selectionContinuous"
                                     Content="Pick continuously until Esc"
                                     GroupName="SelectionMode"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource P13Card}">
                    <StackPanel>
                        <TextBlock Text="Bubble Display" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton x:Name="actionBoth"
                                     Content="Show both ends"
                                     GroupName="ActionMode"/>
                        <RadioButton x:Name="actionNone"
                                     Content="Hide both ends"
                                     GroupName="ActionMode"/>
                        <RadioButton x:Name="actionPrimary"
                                     Content="Show left / bottom end"
                                     GroupName="ActionMode"/>
                        <RadioButton x:Name="actionSecondary"
                                     Content="Show right / top end"
                                     GroupName="ActionMode"/>
                        <RadioButton x:Name="actionSmart"
                                     Content="Smart outside end (crop-aware)"
                                     GroupName="ActionMode"
                                     IsChecked="True"/>
                        <RadioButton x:Name="actionToggle"
                                     Content="Toggle each grid through 4 states"
                                     GroupName="ActionMode"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource P13Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Options" FontSize="14" FontWeight="SemiBold"/>
                    <CheckBox x:Name="orientByView"
                              Content="Determine ends by active view orientation"
                              IsChecked="True"
                              Margin="0,10,0,0"/>
                    <TextBlock Text="Horizontal grids use left/right; vertical grids use bottom/top. Arc and diagonal grids use their endpoint chord. If disabled, the tool uses Revit End 0/End 1."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="22,5,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Smart outside end chooses the endpoint nearest the active view crop boundary and falls back to left/bottom when both ends are equally close."
                               Foreground="#7DD3FC"
                               Margin="22,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Settings are remembered for the next run."
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Click="cancel_clicked"/>
                <Button Grid.Column="3"
                        Content="Start"
                        Style="{StaticResource PrimaryButton}"
                        Click="start_clicked"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
