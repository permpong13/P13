  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nactive_view_id = doc.ActiveView.Id\r\n\r\ntarget_workset = str(IN[0]).strip() if IN[0] else \"\"\r\n\r\nview_equipments = FilteredElementCollector(doc, active_view_id)\\\r\n    .OfCategory(BuiltInCategory.OST_ElectricalEquipment)\\\r\n    .WhereElementIsNotElementType().ToElements()\r\nview_conduits = FilteredElementCollector(doc, active_view_id)\\\r\n    .OfCategory(BuiltInCategory.OST_Conduit)\\\r\n    .WhereElementIsNotElementType().ToElements()\r\n\r\nif target_workset:\r\n    manholes = [e for e in view_equipments\r\n                if doc.GetWorksetTable().GetWorkset(e.WorksetId).Name == target_workset]\r\nelse:\r\n    manholes = list(view_equipments)\r\n\r\ndef mm_to_ft(mm):\r\n    return UnitUtils.ConvertToInternalUnits(mm, UnitTypeId.Millimeters)\r\n\r\ndef ft_to_mm(ft):\r\n    return UnitUtils.ConvertFromInternalUnits(ft, UnitTypeId.Millimeters)\r\n\r\ndef eid(element_id):\r\n    return getattr(element_id, \"Value\",\r\n           getattr(element_id, \"IntegerValue\", str(element_id)))\r\n\r\ndef endpoint_in_bbox(pt, mn, mx):\r\n    return (mn.X <= pt.X <= mx.X and\r\n            mn.Y <= pt.Y <= mx.Y and\r\n            mn.Z <= pt.Z <= mx.Z)\r\n\r\ndef get_floor_z(manhole, origin):\r\n    \"\"\"หาพื้นบ่อจริงจาก face ที่หันขึ้น (+Z) และมี area มากที่สุด\"\"\"\r\n    try:\r\n        opt = Options()\r\n        opt.ComputeReferences = True\r\n        opt.DetailLevel = ViewDetailLevel.Fine\r\n        geom = manhole.get_Geometry(opt)\r\n        floor_candidates = {}\r\n\r\n        def scan(geo_elems):\r\n            for obj in geo_elems:\r\n                if isinstance(obj, Solid) and obj.Volume > 0:\r\n                    for face in obj.Faces:\r\n                        normal = face.ComputeNormal(UV(0.5, 0.5))\r\n                        if normal.IsAlmostEqualTo(XYZ.BasisZ):\r\n                            fz = face.Evaluate(UV(0.5, 0.5)).Z\r\n                            if fz < (origin.Z - 0.5):\r\n                                key = round(fz, 4)\r\n                                floor_candidates[key] = floor_candidates.get(key, 0) + face.Area\r\n                elif isinstance(obj, GeometryInstance):\r\n                    scan(obj.GetInstanceGeometry())\r\n\r\n        scan(geom)\r\n        if floor_candidates:\r\n            return max(floor_candidates, key=floor_candidates.get)\r\n    except:\r\n        pass\r\n    # fallback: BBox.Min.Z\r\n    return manhole.get_BoundingBox(None).Min.Z\r\n\r\ndef set_val(manhole, param_name, value_ft):\r\n    p = manhole.LookupParameter(param_name)\r\n    if not p or p.IsReadOnly:\r\n        return\r\n    if value_ft < 0:\r\n        value_ft = 0.0\r\n    val_mm = round(ft_to_mm(value_ft))\r\n    p.Set(mm_to_ft(val_mm))\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nresults = []\r\n\r\nfor manhole in manholes:\r\n    if not manhole.LookupParameter(\"CNT_Connection 1\"):\r\n        continue\r\n    try:\r\n        transform  = manhole.GetTransform()\r\n        origin     = transform.Origin\r\n        bbox       = manhole.get_BoundingBox(None)\r\n\r\n        # ขอบเขตบ่อ = BBox พอดี + buffer 50mm\r\n        buf     = mm_to_ft(5.0)\r\n        lim_min = XYZ(bbox.Min.X - buf, bbox.Min.Y - buf, bbox.Min.Z - buf)\r\n        lim_max = XYZ(bbox.Max.X + buf, bbox.Max.Y + buf, bbox.Max.Z + buf)\r\n\r\n        # หาพื้นบ่อจริงด้วย Geometry\r\n        base_z = get_floor_z(manhole, origin)\r\n\r\n        main_s  = [[], [], [], []]\r\n        extra_s = [[], [], [], []]\r\n\r\n        for conduit in view_conduits:\r\n            if not hasattr(conduit.Location, \"Curve\"):\r\n                continue\r\n            curve = conduit.Location.Curve\r\n            p0 = curve.GetEndPoint(0)\r\n            p1 = curve.GetEndPoint(1)\r\n\r\n            # เลือก endpoint ที่อยู่ใน BBox บ่อ\r\n            in0 = endpoint_in_bbox(p0, lim_min, lim_max)\r\n            in1 = endpoint_in_bbox(p1, lim_min, lim_max)\r\n            if not in0 and not in1:\r\n                continue\r\n            pt = p0 if in0 else p1\r\n\r\n            # classify extra ด้วยชื่อ type\r\n            c_type    = doc.GetElement(conduit.GetTypeId())\r\n            type_name = c_type.get_Parameter(\r\n                BuiltInParameter.SYMBOL_NAME_PARAM).AsString().lower()\r\n            is_extra  = \"without duct\" in type_name\r\n\r\n            # แยกด้านด้วย angle (รองรับบ่อหมุนทุกองศา)\r\n            lpt       = transform.Inverse.OfPoint(pt)\r\n            angle_deg = math.degrees(math.atan2(lpt.Y, lpt.X))\r\n\r\n            if   angle_deg >= 135 or angle_deg <= -135: side = 0  # Connection 1\r\n            elif -135 < angle_deg <= -45:               side = 1  # Connection 2\r\n            elif  -45 < angle_deg <=  45:               side = 2  # Connection 3\r\n            else:                                        side = 3  # Connection 4\r\n\r\n            # depth = ระยะจากพื้นบ่อขึ้นมาหา conduit\r\n            depth = pt.Z - base_z\r\n\r\n            if is_extra:\r\n                extra_s[side].append(depth)\r\n            else:\r\n                main_s[side].append(depth)\r\n\r\n        # เขียน parameter (ใช้ min = ต่ำสุด ตาม design intent)\r\n        for i, label in enumerate([\"1\", \"2\", \"3\", \"4\"]):\r\n            mv = min(main_s[i])  if main_s[i]  else 0.0\r\n            ev = min(extra_s[i]) if extra_s[i] else 0.0\r\n            set_val(manhole, f\"CNT_Connection {label}\",       mv)\r\n            set_val(manhole, f\"CNT_Connection {label} Extra\", ev)\r\n\r\n        results.append(\r\n            f\"✅ [{eid(manhole.Id)}] \"\r\n            f\"main={[round(ft_to_mm(min(s)) if s else 0) for s in main_s]} \"\r\n            f\"extra={[round(ft_to_mm(min(s)) if s else 0) for s in extra_s]}\"\r\n        )\r\n\r\n    except Exception as ex:\r\n        results.append(f\"❌ [{eid(manhole.Id)}] {ex}\")\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = \"\\n\".join(results)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
