    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nactive_view_id = doc.ActiveView.Id \r\n\r\ntarget_workset = IN[0]\r\nif target_workset: target_workset = str(target_workset).strip()\r\nelse: target_workset = \"\"\r\n\r\nforce_refresh = IN[1] \r\n\r\ndef get_workset_name(element):\r\n    try: return doc.GetWorksetTable().GetWorkset(element.WorksetId).Name\r\n    except: return \"\"\r\n\r\nview_equipments = FilteredElementCollector(doc, active_view_id)\\\r\n                 .OfCategory(BuiltInCategory.OST_ElectricalEquipment)\\\r\n                 .WhereElementIsNotElementType()\\\r\n                 .ToElements()\r\n\r\nview_conduits = FilteredElementCollector(doc, active_view_id)\\\r\n               .OfCategory(BuiltInCategory.OST_Conduit)\\\r\n               .WhereElementIsNotElementType()\\\r\n               .ToElements()\r\n\r\nview_fittings = FilteredElementCollector(doc, active_view_id)\\\r\n               .OfCategory(BuiltInCategory.OST_ConduitFitting)\\\r\n               .WhereElementIsNotElementType()\\\r\n               .ToElements()\r\n\r\nif target_workset != \"\":\r\n    manholes = [e for e in view_equipments if get_workset_name(e) == target_workset]\r\nelse:\r\n    manholes = view_equipments\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\nsuccess_count = 0\r\nskipped_count = 0\r\n\r\nfor manhole in manholes:\r\n    if not manhole.LookupParameter(\"CNT_Connection 1\"): continue\r\n    if not hasattr(manhole, \"Location\"): continue\r\n\r\n    transform = manhole.GetTransform()\r\n    origin = transform.Origin\r\n\r\n    opt = Options()\r\n    opt.ComputeReferences = True\r\n    opt.DetailLevel = ViewDetailLevel.Fine\r\n    geomElem = manhole.get_Geometry(opt)\r\n    floor_candidates = {}\r\n\r\n    def find_inner_floors(geometry_elements):\r\n        for obj in geometry_elements:\r\n            if isinstance(obj, Solid) and obj.Volume > 0:\r\n                for face in obj.Faces:\r\n                    normal = face.ComputeNormal(UV(0.5, 0.5))\r\n                    if normal.IsAlmostEqualTo(XYZ.BasisZ):\r\n                        face_z = face.Evaluate(UV(0.5, 0.5)).Z\r\n                        if face_z < (origin.Z - 0.5):\r\n                            z_key = round(face_z, 4)\r\n                            floor_candidates[z_key] = floor_candidates.get(z_key, 0) + face.Area\r\n            elif isinstance(obj, GeometryInstance):\r\n                find_inner_floors(obj.GetInstanceGeometry())\r\n\r\n    find_inner_floors(geomElem)\r\n    if floor_candidates: manhole_bottom_z = max(floor_candidates, key=floor_candidates.get)\r\n    else: manhole_bottom_z = manhole.get_BoundingBox(None).Min.Z\r\n\r\n    main_side1, main_side2, main_side3, main_side4 = [], [], [], []\r\n    extra_side1, extra_side2, extra_side3, extra_side4 = [], [], [], []\r\n    \r\n    has_fitting_s1, has_fitting_s2, has_fitting_s3, has_fitting_s4 = False, False, False, False\r\n\r\n    # 1. สแกนหาท่อ (Conduit)\r\n    for conduit in view_conduits:\r\n        if not hasattr(conduit.Location, \"Curve\"): continue \r\n            \r\n        curve = conduit.Location.Curve\r\n        pt_start = curve.GetEndPoint(0)\r\n        pt_end = curve.GetEndPoint(1)\r\n        dist_start = pt_start.DistanceTo(origin)\r\n        dist_end = pt_end.DistanceTo(origin)\r\n        \r\n        # 🔥 [แก้บั๊ก XYZ] ลบแกนตรงๆ ทีละแกน ป้องกัน Python 3 งง\r\n        if dist_start > dist_end:\r\n            closest_pt = pt_end\r\n            conduit_vec = XYZ(pt_end.X - pt_start.X, pt_end.Y - pt_start.Y, pt_end.Z - pt_start.Z)\r\n        else:\r\n            closest_pt = pt_start\r\n            conduit_vec = XYZ(pt_start.X - pt_end.X, pt_start.Y - pt_end.Y, pt_start.Z - pt_end.Z)\r\n            \r\n        if min(dist_start, dist_end) > 10.0: continue \r\n            \r\n        is_extra = False\r\n        conduit_name = conduit.Name.lower()\r\n        conduit_type = doc.GetElement(conduit.GetTypeId())\r\n        type_name = conduit_type.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM).AsString().lower() if conduit_type else \"\"\r\n        \r\n        if \"without duct\" in conduit_name or \"without duct\" in type_name:\r\n            is_extra = True \r\n            \r\n        local_vec = transform.Inverse.OfVector(conduit_vec)\r\n        conduit_z = closest_pt.Z\r\n        \r\n        if abs(local_vec.X) >= abs(local_vec.Y):\r\n            if local_vec.X > 0:\r\n                if is_extra: extra_side1.append(conduit_z)\r\n                else: main_side1.append(conduit_z)\r\n            else:\r\n                if is_extra: extra_side3.append(conduit_z)\r\n                else: main_side3.append(conduit_z)\r\n        else:\r\n            if local_vec.Y > 0:\r\n                if is_extra: extra_side2.append(conduit_z)\r\n                else: main_side2.append(conduit_z)\r\n            else:\r\n                if is_extra: extra_side4.append(conduit_z)\r\n                else: main_side4.append(conduit_z)\r\n\r\n    # 2. สแกนหา Fitting\r\n    for fitting in view_fittings:\r\n        if not hasattr(fitting, \"Location\") or not fitting.Location: continue\r\n        \r\n        loc = fitting.Location\r\n        pt = None\r\n        if hasattr(loc, \"Point\"): pt = loc.Point\r\n        elif hasattr(loc, \"Curve\") and loc.Curve: pt = loc.Curve.Evaluate(0.5, True)\r\n        \r\n        if not pt: continue\r\n        if pt.DistanceTo(origin) > 10.0: continue \r\n        \r\n        # 🔥 [แก้บั๊ก XYZ] ลบแกนตรงๆ ทีละแกน ป้องกัน Python 3 งง\r\n        fitting_vec = XYZ(origin.X - pt.X, origin.Y - pt.Y, origin.Z - pt.Z)\r\n        local_vec = transform.Inverse.OfVector(fitting_vec)\r\n        \r\n        if abs(local_vec.X) >= abs(local_vec.Y):\r\n            if local_vec.X > 0: has_fitting_s1 = True\r\n            else: has_fitting_s3 = True\r\n        else:\r\n            if local_vec.Y > 0: has_fitting_s2 = True\r\n            else: has_fitting_s4 = True\r\n\r\n    def get_lowest_offset(z_list, base_z, has_fitting):\r\n        if len(z_list) == 0: \r\n            if has_fitting: \r\n                return None \r\n            return 0.0 \r\n        return min(z_list) - base_z\r\n\r\n    val_m1 = get_lowest_offset(main_side1, manhole_bottom_z, has_fitting_s1)\r\n    val_m2 = get_lowest_offset(main_side2, manhole_bottom_z, has_fitting_s2)\r\n    val_m3 = get_lowest_offset(main_side3, manhole_bottom_z, has_fitting_s3)\r\n    val_m4 = get_lowest_offset(main_side4, manhole_bottom_z, has_fitting_s4)\r\n\r\n    val_e1 = get_lowest_offset(extra_side1, manhole_bottom_z, has_fitting_s1)\r\n    val_e2 = get_lowest_offset(extra_side2, manhole_bottom_z, has_fitting_s2)\r\n    val_e3 = get_lowest_offset(extra_side3, manhole_bottom_z, has_fitting_s3)\r\n    val_e4 = get_lowest_offset(extra_side4, manhole_bottom_z, has_fitting_s4)\r\n\r\n    def set_param_direct(element, param_name, value):\r\n        if value is None: \r\n            return \r\n            \r\n        param = element.LookupParameter(param_name)\r\n        if param and param.IsReadOnly == False:\r\n            if value == 0.0:\r\n                new_internal_val = 0.0\r\n            else:\r\n                val_mm_rounded = round(value * 304.8, 0)\r\n                new_internal_val = val_mm_rounded / 304.8\r\n            \r\n            if abs(param.AsDouble() - new_internal_val) > 0.001: \r\n                param.Set(new_internal_val)\r\n\r\n    try:\r\n        set_param_direct(manhole, \"CNT_Connection 1\", val_m1)\r\n        set_param_direct(manhole, \"CNT_Connection 2\", val_m2)\r\n        set_param_direct(manhole, \"CNT_Connection 3\", val_m3)\r\n        set_param_direct(manhole, \"CNT_Connection 4\", val_m4)\r\n        \r\n        set_param_direct(manhole, \"CNT_Connection 1 Extra\", val_e1)\r\n        set_param_direct(manhole, \"CNT_Connection 2 Extra\", val_e2)\r\n        set_param_direct(manhole, \"CNT_Connection 3 Extra\", val_e3)\r\n        set_param_direct(manhole, \"CNT_Connection 4 Extra\", val_e4)\r\n        success_count += 1\r\n    except:\r\n        skipped_count += 1 \r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = f\"✅ สำเร็จ (แก้บั๊ก XYZ สำหรับ Python 3): {success_count} บ่อ | ⚠️ ข้ามบ่อ Error: {skipped_count} บ่อ\"",
