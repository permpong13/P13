<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="P13 AI Console"
        Width="760"
        Height="720"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#F6F6F6"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushP13" Color="#E5E5E7"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6E6E73"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#D1D1D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#D1D1D6"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="P13Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushP13}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonShell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#D1D1D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShell" Property="Background" Value="#F2F2F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonShell" Property="Background" Value="#E5E5EA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrafficLightButton" TargetType="Button">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Dot" Background="{TemplateBinding Background}" CornerRadius="6"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{StaticResource WindowBackground}"
            BorderBrush="#D4D4D4"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- macOS Header Bar with Traffic Lights -->
            <Border Grid.Row="0"
                    x:Name="titleBar"
                    Background="#F6F6F6"
                    BorderBrush="#E5E5E7"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button x:Name="closeButton" Style="{StaticResource TrafficLightButton}" Background="#FF5F56" ToolTip="Close"/>
                        <Button x:Name="minimizeButton" Style="{StaticResource TrafficLightButton}" Background="#FFBD2E" ToolTip="Minimize"/>
                        <Button x:Name="maximizeButton" Style="{StaticResource TrafficLightButton}" Background="#27C93F" ToolTip="Maximize"/>
                    </StackPanel>
                    <TextBlock Text="P13 AI Console"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#1D1D1F"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="20,16,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Hero Section -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="12" Background="#E0F2FE">
                        <Grid>
                            <TextBlock Text="AI"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#0284C7"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="P13 AI Console" FontSize="20" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                        <TextBlock Text="Choose an AI provider and model, then give it a Revit task through P13 MCP."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Provider Card -->
                <Border Grid.Row="1" Style="{StaticResource P13Card}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <Label Content="AI Provider" FontWeight="SemiBold"/>
                            <ComboBox x:Name="providerCombo" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <Label Content="Model ID" FontWeight="SemiBold"/>
                            <ComboBox x:Name="modelCombo"
                                      Margin="0,6,0,0"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <Label Content="Provider Base URL" FontWeight="SemiBold"/>
                            <TextBox x:Name="baseUrlBox" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0" x:Name="apiKeyPanel">
                            <Label x:Name="apiKeyLabel" Content="API Key (Saved to User Environment)" FontWeight="SemiBold"/>
                            <TextBox x:Name="apiKeyBox" Margin="0,6,0,0" ToolTip="Enter or paste your GEMINI_API_KEY, OPENAI_API_KEY, or ANTHROPIC_API_KEY."/>
                        </StackPanel>

                        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="providerStatusText"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="API keys are saved safely to Windows User Environment and read automatically."
                                           Foreground="#0284C7"
                                           FontSize="11"
                                           Margin="0,4,12,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="testRuntimeButton"
                                        Content="Test Runtime"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="refreshModelsButton"
                                        Content="Refresh Models"
                                        Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Task Prompt Card -->
                <Border Grid.Row="2" Style="{StaticResource P13Card}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Task Prompt" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1"
                                 x:Name="promptBox"
                                 Margin="0,8,0,0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="150"
                                 VerticalContentAlignment="Top"
                                 ToolTip="Describe what the AI should inspect, preview, or change in the active Revit document."/>
                    </Grid>
                </Border>

                <!-- Settings Card -->
                <Border Grid.Row="3" Style="{StaticResource P13Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <CheckBox x:Name="allowWriteCheck"
                                  Content="Allow this AI task to make confirmed changes in Revit"
                                  IsChecked="False"/>
                        <TextBlock Text="When disabled, the AI can inspect the model and generate previews only. When enabled, P13 still requires confirm_write and preview signatures where supported."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="22,4,0,0"
                                   TextWrapping="Wrap"/>
                        <CheckBox x:Name="saveHistoryCheck"
                                  Content="Save the AI result in local task history"
                                  IsChecked="False"
                                  Margin="0,10,0,0"/>
                        <TextBlock Text="Disabled by default for privacy. The PowerShell task window still shows the result."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="22,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Footer Bar -->
                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="The task opens in a separate window so Revit remains available to MCP."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,12,0"/>
                    <Button Grid.Column="1"
                            x:Name="historyButton"
                            Content="History"
                            Style="{StaticResource SecondaryButton}"/>
                    <Button Grid.Column="3"
                            x:Name="cancelButton"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}"/>
                    <Button Grid.Column="5"
                            x:Name="startButton"
                            Content="Start AI Task"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
