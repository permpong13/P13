  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\nclr.AddReference('ProtoGeometry')\nfrom Autodesk.DesignScript.Geometry import *\n\ninput_geometry = IN[0]\n\ndef extract_coordinates(geo_list):\n    results = []\n    if not isinstance(geo_list, list):\n        geo_list = [geo_list]\n        \n    for item in geo_list:\n        if item is None:\n            results.append([0.0, 0.0, 0.0])\n            continue\n            \n        if isinstance(item, list):\n            results.append(extract_coordinates(item))\n        else:\n            try:\n                results.append([item.X, item.Y, item.Z])\n            except:\n                results.append([0.0, 0.0, 0.0])\n                \n    return results\n\nOUT = extract_coordinates(input_geometry)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "419fcb81e69f483189b28a0c824e601b",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "0b0b5ffdb6d14cc9a5dcb0ab59e0da8a",
          "Name": "IN[0]",
          "Description": "geometry",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "ab5b2785664347959e839ad949060b0a",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
