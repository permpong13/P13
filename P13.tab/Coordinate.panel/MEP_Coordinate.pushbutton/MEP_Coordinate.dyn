      ],
      "Outputs": [
        {
          "Id": "2e0b12ea69064da28e087f42ba89e204",
          "Name": "E_Value",
          "Description": "E_Value = DesignScript.Builtin.Get.ValueAtIndex(data, 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "81225364bf044116afdac1092103d2e2",
          "Name": "N_Value",
          "Description": "N_Value = DesignScript.Builtin.Get.ValueAtIndex(data, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "E_Value = data[0];\nN_Value = data[1];"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\ninput_geometry = IN[0]\r\n\r\ndef process_geometry(geo):\r\n    x_coords = []\r\n    y_coords = []\r\n    \r\n    # ฟังก์ชันทะลวง List และดักจับค่าว่าง (None)\r\n    def extract(item):\r\n        if item is None:\r\n            x_coords.append(0.0)\r\n            y_coords.append(0.0)\r\n        elif isinstance(item, list):\r\n            for sub_item in item:\r\n                extract(sub_item)\r\n        else:\r\n            try:\r\n                x_coords.append(item.X)\r\n                y_coords.append(item.Y)\r\n            except:\r\n                x_coords.append(0.0)\r\n                y_coords.append(0.0)\r\n                \r\n    extract(input_geometry)\r\n    return [x_coords, y_coords] # ส่งออกเป็น List ใหญ่ที่มี 2 ก้อนย่อย\r\n\r\n# ส่งค่าออกพอร์ต OUT (ช่องเดียว)\r\nOUT = process_geometry(input_geometry)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "8843f80476204dbf83486996fa30045d",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "dbf461abcf4c44708cf816cdcaaa0119",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "a354d9a679d84a33a87d150e1aea24ba",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    }
