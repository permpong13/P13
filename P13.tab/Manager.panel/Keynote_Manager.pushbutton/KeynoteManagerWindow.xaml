<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        Width="1100" Height="760"
        MinWidth="960" MinHeight="600"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Title="Keynote Manager"
        Closing="window_closing"
        KeyDown="window_keydown">

    <Window.Resources>
        <!-- ============================================================ -->
        <!-- COLOR PALETTE                                                -->
        <!-- ============================================================ -->
        <SolidColorBrush x:Key="AccentBrush"        Color="#0A84FF"/>
        <SolidColorBrush x:Key="AccentLightBrush"   Color="#E8F2FF"/>
        <SolidColorBrush x:Key="AccentHoverBrush"   Color="#006EDB"/>
        <SolidColorBrush x:Key="BorderBrush"        Color="#D7D7DE"/>
        <SolidColorBrush x:Key="BorderLightBrush"   Color="#EFEFF4"/>
        <SolidColorBrush x:Key="BgPanelBrush"       Color="#F2F2F7"/>
        <SolidColorBrush x:Key="BgWhiteBrush"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#1D1D1F"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#636366"/>
        <SolidColorBrush x:Key="TextMutedBrush"     Color="#8E8E93"/>
        <SolidColorBrush x:Key="WarningBrush"       Color="#FF9F0A"/>
        <SolidColorBrush x:Key="DangerBrush"        Color="#FF453A"/>
        <SolidColorBrush x:Key="LockedBgBrush"      Color="#FFF6D8"/>
        <SolidColorBrush x:Key="DragOverBrush"      Color="#EAF4FF"/>
        <SolidColorBrush x:Key="UsedBadgeBgBrush"   Color="#E8F8EE"/>
        <SolidColorBrush x:Key="UsedBadgeFgBrush"   Color="#248A3D"/>
        <SolidColorBrush x:Key="CatBadgeBrush"      Color="#3A3A3C"/>
        <SolidColorBrush x:Key="StatusBrush"        Color="#F7F7FA"/>
        <SolidColorBrush x:Key="HoverBrush"         Color="#F4F8FF"/>
        <SolidColorBrush x:Key="ToolbarBrush"       Color="#FAFAFC"/>

        <!-- ============================================================ -->
        <!-- BASE BUTTON STYLES                                           -->
        <!-- ============================================================ -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E9E9ED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D8D8DE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
        </Style>

        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ToolbarSep" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Fill" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="28,0,28,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BgWhiteBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InspectorLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,12,0,3"/>
        </Style>

        <Style x:Key="InspectorValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ============================================================ -->
        <!-- TREEVIEW ITEM CONTAINER                                      -->
        <!-- ============================================================ -->
        <Style x:Key="TreeItemContainer" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding locked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource LockedBgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding used}" Value="True">
                    <Setter Property="FontWeight" Value="Medium"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- HIERARCHICAL DATA TEMPLATE (the core visual for each node)   -->
        <!-- ============================================================ -->
        <HierarchicalDataTemplate x:Key="KeynoteTreeItem"
                                  ItemsSource="{Binding children}">
            <Border x:Name="itemBorder" Padding="8,5" Margin="0,1,8,1"
                    CornerRadius="7"
                    AllowDrop="True"
                    DragOver="tree_item_drag_over"
                    DragLeave="tree_item_drag_leave"
                    Drop="tree_item_drop">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- MULTI SELECT -->
                    <CheckBox x:Name="multiSelectBox" Grid.Column="0"
                              Margin="0,0,7,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding multi_selected, Mode=TwoWay}"
                              ToolTip="Select this record and child records. Shift-click selects a range."
                              Checked="multi_select_checked"
                              Unchecked="multi_select_unchecked"/>

                    <!-- KEY BADGE -->
                    <Border x:Name="keyBadge" Grid.Column="1"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="8" Padding="8,2,8,3"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            MinWidth="42" MaxWidth="150">
                        <TextBlock Text="{Binding key}"
                                   Foreground="White" FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- KEYNOTE TEXT -->
                    <TextBlock x:Name="textDisplay" Grid.Column="2"
                               Text="{Binding text}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- STATUS BADGES -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0,0,0">
                        <!-- Child count -->
                        <Border x:Name="childCountBadge" Visibility="Collapsed"
                                Background="{StaticResource BorderLightBrush}"
                                CornerRadius="8" Padding="5,1,5,2"
                                Margin="0,0,4,0">
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} items">
                                        <Binding Path="children.Count"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                        <!-- Used count -->
                        <Border x:Name="usedBadge" Visibility="Collapsed"
                                Background="{StaticResource UsedBadgeBgBrush}"
                                CornerRadius="8" Padding="5,1,5,2"
                                Margin="0,0,4,0"
                                ToolTip="{Binding tooltip}">
                            <TextBlock Foreground="{StaticResource UsedBadgeFgBrush}"
                                       FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}x">
                                        <Binding Path="used_count"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                        <!-- Lock badge -->
                        <Border x:Name="lockBadge" Visibility="Collapsed"
                                Background="{StaticResource WarningBrush}"
                                CornerRadius="8" Padding="6,1,6,2">
                            <TextBlock Foreground="White"
                                       FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="&#x1F512; {0}">
                                        <Binding Path="owner"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding is_category}" Value="True">
                    <Setter TargetName="keyBadge"    Property="Background" Value="{StaticResource CatBadgeBrush}"/>
                    <Setter TargetName="itemBorder"   Property="Margin"     Value="0,7,8,3"/>
                    <Setter TargetName="textDisplay"  Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="childCountBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding used}" Value="True">
                    <Setter TargetName="usedBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding locked}" Value="True">
                    <Setter TargetName="lockBadge"  Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

    </Window.Resources>

    <!-- ================================================================ -->
    <!-- MAIN LAYOUT                                                      -->
    <!-- ================================================================ -->
    <Grid Background="{StaticResource BgPanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0 - FILE TOOLBAR -->
        <Border Grid.Row="0"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="undoBtn" Style="{StaticResource PillButton}"
                            Content="Undo" ToolTip="Undo last action (Ctrl+Z)"
                            Click="undo_action"/>
                    <Button Style="{StaticResource PillButton}"
                            Content="Import" ToolTip="Import from .txt (Ctrl+I)"
                            Click="import_keynotes"/>
                    <Button Style="{StaticResource PillButton}"
                            Content="Export All" Click="export_keynotes"/>
                    <Button Style="{StaticResource PillButton}"
                            Content="Export Visible" Click="export_visible_keynotes"/>
                    <Rectangle Style="{StaticResource ToolbarSep}"/>
                    <Button Style="{StaticResource PillButton}"
                            Content="Backup" ToolTip="Create a timestamped backup"
                            Click="backup_keynote_file"/>
                    <Button Style="{StaticResource PillButton}"
                            Content="Recent" ToolTip="Open a recent keynote file"
                            Click="show_recent_files"/>
                    <Rectangle Style="{StaticResource ToolbarSep}"/>
                    <Button Style="{StaticResource PillButton}"
                            Content="Change File" Click="change_keynote_file"/>
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="&#x1F4C2;" FontSize="14"
                            ToolTip="Show in Explorer" Click="show_keynote_file"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                        <Ellipse Width="11" Height="11" Fill="#FF5F57" Margin="0,0,7,0"/>
                        <Ellipse Width="11" Height="11" Fill="#FEBC2E" Margin="0,0,7,0"/>
                        <Ellipse Width="11" Height="11" Fill="#28C840"/>
                    </StackPanel>
                    <TextBlock Text="P13 Keynote Manager"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,14,0"/>
                    <Button Style="{StaticResource PillButton}"
                            Content="&#x21BB; Refresh" ToolTip="F5" Click="refresh"/>
                    <Rectangle Style="{StaticResource ToolbarSep}"/>
                    <Button Style="{StaticResource AccentButton}"
                            Content="Update Model" Padding="14,4"
                            Click="update_model"/>
                    <Rectangle Style="{StaticResource ToolbarSep}"/>
                    <Button Style="{StaticResource PillButton}"
                            Content="Validate" ToolTip="Validate keynote structure"
                            Click="validate_keynotes"/>
                    <Button Style="{StaticResource PillButton}"
                            Content="Audit" ToolTip="Audit model keynote usage"
                            Click="audit_keynotes"/>
                    <Button Style="{StaticResource PillButton}"
                            Content="Health Report" ToolTip="Export comprehensive keynote report"
                            Click="export_health_report"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1 - SEARCH + TREE TOOLBAR -->
        <Border Grid.Row="1"
                Background="{StaticResource BgWhiteBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PillButton}"
                            Content="&#x25BC; Filters" Margin="6,0,0,0"
                            Click="custom_filter"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                        <Button Style="{StaticResource PillButton}"
                                Content="Used" ToolTip="Show used keynotes"
                                Click="filter_used"/>
                        <Button Style="{StaticResource PillButton}"
                                Content="Unused" ToolTip="Show unused keynotes"
                                Click="filter_unused"/>
                        <Button Style="{StaticResource PillButton}"
                                Content="View" ToolTip="Show keynotes visible in active view"
                                Click="filter_visible_in_view"/>
                    </StackPanel>
                    <Grid>
                        <TextBox x:Name="search_tb" Style="{StaticResource SearchBox}"
                                 TextChanged="search_txt_changed"/>
                        <TextBlock Text="&#x1F50D;  Search keynotes..."
                                   FontSize="12" IsHitTestVisible="False"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="8,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=search_tb}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="clrsearch_b" Visibility="Collapsed"
                                Style="{StaticResource FlatButton}"
                                HorizontalAlignment="Right" Width="24" Height="24"
                                Content="&#x2715;" FontSize="10"
                                Foreground="{StaticResource TextMutedBrush}"
                                Click="clear_search"/>
                    </Grid>
                </DockPanel>

                <!-- Action toolbar -->
                <DockPanel Grid.Row="1" Margin="0,9,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock Text="Place:" VerticalAlignment="Center"
                                   FontSize="11" Margin="0,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <RadioButton x:Name="userknote_rb" Content="User"
                                     VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                        <RadioButton x:Name="elementknote_rb" Content="Element"
                                     VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                        <RadioButton x:Name="materialknote_rb" Content="Material"
                                     VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <!-- Add Group / Keynote -->
                        <Button x:Name="addCategoryBtn" Style="{StaticResource ToolbarButton}"
                                ToolTip="Add group (top-level category)" Click="add_category">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="Grp" FontSize="9" Margin="2,0,0,0"
                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="addKeynoteBtn" Style="{StaticResource ToolbarButton}"
                                ToolTip="Add keynote (Ctrl+N)" Click="add_keynote">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="Key" FontSize="9" Margin="2,0,0,0"
                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSep}"/>

                        <!-- HIERARCHY: Indent / Outdent / Move Up / Move Down -->
                        <Button x:Name="indentBtn" Style="{StaticResource ToolbarButton}" Width="34"
                                ToolTip="Indent - make child of sibling above (Tab)"
                                IsEnabled="False" Click="indent_keynote">
                            <TextBlock Text="&#x21E5;" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Button>
                        <Button x:Name="outdentBtn" Style="{StaticResource ToolbarButton}" Width="34"
                                ToolTip="Outdent - promote up one level (Shift+Tab)"
                                IsEnabled="False" Click="outdent_keynote">
                            <TextBlock Text="&#x21E4;" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Button>
                        <Button x:Name="moveUpBtn" Style="{StaticResource ToolbarButton}" Width="28"
                                ToolTip="Move up (Ctrl+Up)" IsEnabled="False" Click="move_up">
                            <TextBlock Text="&#x25B2;" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                        <Button x:Name="moveDownBtn" Style="{StaticResource ToolbarButton}" Width="28"
                                ToolTip="Move down (Ctrl+Down)" IsEnabled="False" Click="move_down">
                            <TextBlock Text="&#x25BC;" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSep}"/>

                        <!-- Edit / Duplicate / Re-Key -->
                        <Button x:Name="editKeynoteBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x270E;" FontSize="13"
                                ToolTip="Edit (F2)" IsEnabled="False" Click="edit_keynote"/>
                        <Button x:Name="dupKeynoteBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x2750;" FontSize="13"
                                ToolTip="Duplicate (Ctrl+D)" IsEnabled="False" Click="duplicate_keynote"/>
                        <Button x:Name="rekeyBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x1F511;" FontSize="12"
                                ToolTip="Change key" IsEnabled="False" Click="rekey_keynote"/>

                        <Rectangle Style="{StaticResource ToolbarSep}"/>

                        <!-- Capitalization -->
                        <Button x:Name="caseBtn" Style="{StaticResource ToolbarButton}"
                                Width="36" ToolTip="Change text capitalization"
                                IsEnabled="False" Click="show_case_menu">
                            <TextBlock Text="Aa" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="caseMenu">
                                    <MenuItem Header="UPPER CASE"   Click="to_upper"    InputGestureText="TT"/>
                                    <MenuItem Header="lower case"   Click="to_lower"    InputGestureText="tt"/>
                                    <MenuItem Header="Title Case"   Click="to_title"    InputGestureText="Tt"/>
                                    <MenuItem Header="Sentence case" Click="to_sentence" InputGestureText="Se"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSep}"/>

                        <!-- Delete -->
                        <Button x:Name="removeBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x2715;" FontSize="12"
                                Foreground="{StaticResource DangerBrush}"
                                ToolTip="Delete selected record(s) (Del)" IsEnabled="False" Click="remove_keynote"/>

                        <Rectangle Style="{StaticResource ToolbarSep}"/>

                        <!-- Find / Place -->
                        <Button x:Name="findBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x1F50D;" FontSize="12"
                                ToolTip="Find in model" IsEnabled="False" Click="show_keynote"/>
                        <Button x:Name="placeBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x1F4CC;" FontSize="12"
                                ToolTip="Place in model" IsEnabled="False" Click="place_keynote"/>
                        <Button x:Name="inspectBtn" Style="{StaticResource ToolbarButton}"
                                Content="🔍" FontSize="12"
                                ToolTip="Inspect placements in views/sheets" IsEnabled="False" Click="inspect_placements"/>
                        <Rectangle Style="{StaticResource ToolbarSep}"/>
                        <Button x:Name="copyBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x2398;" FontSize="12"
                                ToolTip="Copy key and text" IsEnabled="False" Click="copy_keynote_key_text"/>
                        <Button x:Name="pasteBtn" Style="{StaticResource ToolbarButton}"
                                Content="📋" FontSize="12"
                                ToolTip="Paste from Excel/Clipboard (Ctrl+V)" Click="paste_from_clipboard"/>
                        <Button x:Name="bulkBtn" Style="{StaticResource ToolbarButton}"
                                Content="FR" FontSize="11"
                                ToolTip="Find and replace text" Click="bulk_find_replace"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ROW 2 - VALIDATION BANNER -->
        <Border Grid.Row="2" x:Name="validationBanner" Visibility="Collapsed"
                Background="#FFF7E8" BorderBrush="#FFE2B5" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                        Content="Fix Issues" FontWeight="SemiBold" Foreground="#E65100"
                        Click="fix_validation_issues"/>
                <TextBlock x:Name="validationBannerText" Text="⚠️ Validation issues found..."
                           Foreground="#E65100" VerticalAlignment="Center" FontWeight="Medium"/>
            </DockPanel>
        </Border>

        <!-- ROW 3 - THE TREE -->
        <Grid Grid.Row="3" Background="{StaticResource BgPanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="286"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="emptyStateMsg" Grid.Column="0"
                       Text="No keynotes loaded. Add a group to get started."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                       Visibility="Collapsed"/>

            <Border Grid.Column="0"
                    Margin="12,10,8,10"
                    Background="{StaticResource BgWhiteBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TreeView x:Name="keynotes_tv"
                           BorderThickness="0" Background="Transparent" Padding="10,8"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           VirtualizingPanel.IsVirtualizing="True"
                           VirtualizingPanel.VirtualizationMode="Recycling"
                           ItemTemplate="{StaticResource KeynoteTreeItem}"
                           ItemContainerStyle="{StaticResource TreeItemContainer}"
                           SelectedItemChanged="selected_keynote_changed"
                           PreviewMouseLeftButtonDown="tree_preview_mouse_down"
                           PreviewMouseMove="tree_preview_mouse_move"
                           PreviewMouseDoubleClick="tree_double_click"
                           AllowDrop="True"
                           DragOver="tree_drag_over"
                           Drop="tree_drop">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy Key" Click="copy_keynote_key"/>
                            <MenuItem Header="Copy Text" Click="copy_keynote_text"/>
                            <MenuItem Header="Copy Key + Text" Click="copy_keynote_key_text"/>
                            <Separator/>
                            <MenuItem Header="Duplicate With Next Key" Click="duplicate_with_next_key"/>
                            <MenuItem Header="Move to Category" Click="move_to_category"/>
                            <MenuItem Header="Find In Model" Click="show_keynote"/>
                            <MenuItem Header="Inspect Placements" Click="inspect_placements"/>
                            <MenuItem Header="Select In Model" Click="select_keynote_instances"/>
                            <MenuItem Header="Place In Model" Click="place_keynote"/>
                            <Separator/>
                            <MenuItem Header="Undo Last Action" Click="undo_action"/>
                            <MenuItem Header="Validate Keynotes" Click="validate_keynotes"/>
                            <MenuItem Header="Audit Usage" Click="audit_keynotes"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </Border>

            <Border Grid.Column="1"
                    Margin="4,10,12,10"
                    Background="{StaticResource BgWhiteBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Inspector"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Select a keynote or group to review details."
                                   Margin="0,4,0,8"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Style="{StaticResource InspectorLabel}" Text="KEY"/>
                        <TextBlock x:Name="inspectorKey" Style="{StaticResource InspectorValue}" Text="-"/>

                        <TextBlock Style="{StaticResource InspectorLabel}" Text="TYPE"/>
                        <TextBlock x:Name="inspectorType" Style="{StaticResource InspectorValue}" Text="-"/>

                        <TextBlock Style="{StaticResource InspectorLabel}" Text="PARENT"/>
                        <TextBlock x:Name="inspectorParent" Style="{StaticResource InspectorValue}" Text="-"/>

                        <TextBlock Style="{StaticResource InspectorLabel}" Text="CHILDREN"/>
                        <TextBlock x:Name="inspectorChildren" Style="{StaticResource InspectorValue}" Text="-"/>

                        <TextBlock Style="{StaticResource InspectorLabel}" Text="MODEL USE"/>
                        <TextBlock x:Name="inspectorUsed" Style="{StaticResource InspectorValue}" Text="-"/>

                        <TextBlock Style="{StaticResource InspectorLabel}" Text="LOCK"/>
                        <TextBlock x:Name="inspectorLock" Style="{StaticResource InspectorValue}" Text="-"/>

                        <TextBlock Style="{StaticResource InspectorLabel}" Text="TEXT"/>
                        <Border Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10"
                                Margin="0,2,0,0">
                            <TextBlock x:Name="inspectorText"
                                       Style="{StaticResource InspectorValue}"
                                       Text="-"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ROW 4 - STATUS BAR -->
        <Border Grid.Row="4"
                Background="{StaticResource StatusBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <DockPanel>
                <TextBlock x:Name="statusRight" DockPanel.Dock="Right"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Opacity="0.9"/>
                <TextBlock x:Name="statusLeft"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Opacity="0.95"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
